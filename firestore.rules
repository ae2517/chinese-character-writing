rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ▼▼▼ 교수 계정 이메일로 바꾸세요 (Firebase Authentication 에 만든 그 이메일) ▼▼▼
    function isProf() {
      return request.auth != null && request.auth.token.email == 'PROFESSOR_EMAIL@example.com';
    }

    // 단어: 누구나 읽기, 교수만 쓰기
    match /words/{id} {
      allow read: if true;
      allow write: if isProf();
    }

    // 학생: 로그인(ID로 1건 조회)·가입(신규 생성)은 누구나, 목록 조회·수정·삭제는 교수만
    match /students/{sid} {
      allow get: if true;
      allow create: if request.resource.data.id == sid
                    && sid != 'guest'
                    && sid.matches('[0-9]{1,10}')
                    && request.resource.data.passHash is string;
      allow list, delete: if isProf();
      // 비밀번호 재설정: 전화번호 해시를 아는 사람이 같은 요청 안에서 studentPrivate 의 resetAt 을 갱신했을 때만 passHash 변경 허용
      allow update: if isProf() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passHash'])
        && getAfter(/databases/$(database)/documents/studentPrivate/$(sid)).data.resetAt == request.time
      );
    }

    // 전화번호 해시(본인 확인용): 가입 때 생성만 가능, 읽기는 교수만
    match /studentPrivate/{sid} {
      allow create: if sid != 'guest'
                    && request.resource.data.keys().hasOnly(['phoneHash'])
                    && request.resource.data.phoneHash is string
                    && existsAfter(/databases/$(database)/documents/students/$(sid));
      // 본인 확인: 저장된 해시와 같은 값을 보내면서 resetAt 만 요청 시각으로 갱신
      allow update: if isProf() || (
        request.resource.data.phoneHash == resource.data.phoneHash
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resetAt'])
        && request.resource.data.resetAt == request.time
      );
      allow read, delete: if isProf();
    }

    // 전화번호 → ID 색인(아이디 찾기): 해시를 알아야만 1건 조회 가능, 목록 조회 불가
    match /phoneIndex/{h} {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['studentId'])
                    && existsAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId));
      allow list, update, delete: if isProf();
    }

    // 연습 진행(회차 수): 기기를 바꿔도 이어서 세기 위한 카운터 (삭제 불가)
    match /progress/{pid} {
      allow read: if true;
      allow create, update: if request.resource.data.studentId != 'guest';
      allow delete: if isProf();
    }

    // 로그인 기록: 학생은 쓰기만, 읽기는 교수만
    match /logins/{lid} {
      allow create: if request.resource.data.studentId is string
                    && request.resource.data.studentId != 'guest';
      allow read, update, delete: if isProf();
    }

    // 학습 기록: 학생은 '새로 쓰기'만 가능, 읽기·수정·삭제는 교수만
    match /attempts/{aid} {
      allow create: if request.resource.data.studentId is string
                    && request.resource.data.studentId != 'guest'
                    && request.resource.data.id == aid;
      allow read, update, delete: if isProf();
    }
    match /attemptStrokes/{aid} {
      allow create: if request.resource.data.id == aid
                    && request.resource.data.studentId != 'guest';
      allow read, update, delete: if isProf();
    }
  }
}
